      <column caption='DQ Thickness' datatype='string' name='[Calculation_724798120683995137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Thickness_mm])&#13;&#10;    OR ISNULL([Thickness_Loss_mm])&#13;&#10;THEN &quot;Review&quot;&#13;&#10;&#13;&#10;ELSEIF [Thickness_mm] &lt;= 0&#13;&#10;    OR [Thickness_Loss_mm] &lt; 0&#13;&#10;THEN &quot;Review&quot;&#13;&#10;&#13;&#10;ELSEIF [Thickness_Loss_mm] &gt; [Thickness_mm]&#13;&#10;THEN &quot;Review&quot;&#13;&#10;&#13;&#10;ELSE &quot;Pass&quot;&#13;&#10;END' />
      </column>
      <column caption='Loss Ratio' datatype='real' default-format='p0.00%' name='[Calculation_724798120697245698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Thickness_mm] &gt; 0 THEN&#13;&#10;    [Thickness_Loss_mm] / [Thickness_mm]&#13;&#10;END' />
      </column>
      <column caption='Critical Flag' datatype='integer' name='[Calculation_724798120708714499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Condition] = &quot;Critical&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Critical Share' datatype='real' default-format='p0.00%' name='[Calculation_724798120708857860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_724798120708714499])' />
